{{!
    @template mod_syllabus/plan_week_read

    One week, read-only. Shared by the student and tutor tabs (and Tab 1's read-only
    branch) — showtutorfields controls whether interaction tools/observations are shown.
    Details/bibliography/synchronous meeting are always shown: the visibility matrix only
    excludes those two fields and the activity-level grading/tutor fields from the student
    tab, nothing else at week level.

    The coordinator's review notes are rendered inline right below each narrative field, via
    the ...reviewnote objects (only ever populated by plan_read_export::weeks() for Tab 1's
    read branch, canreview true) — resolved through Mustache's normal context-stack fallback
    to the top-level canreview flag, same pattern as structuralhelp in week_row.mustache.
    Absent (null/missing) for the student/tutor tabs, so nothing renders there regardless of
    the viewer's own capabilities.

    Example context (json):
    {
        "id": 2,
        "title": "Week 1 — Introduction",
        "duration": 480,
        "startdate": 1749000000,
        "enddate": 1749600000,
        "hassync": true,
        "syncdate": 1749250000,
        "synclink": "https://meet.example.org/week1",
        "synctopic": "Course introduction",
        "details": "<p>Hello, dear student! Welcome to Week 1...</p>",
        "supportmaterial": "<p>Chapter 1 of the digital material.</p>",
        "supplementarymaterial": "<p>DOE et al. (2023).</p>",
        "showtutorfields": true,
        "interactiontools": "<p>Forum in the virtual coffee room.</p>",
        "notes": "<p>No additional notes.</p>",
        "hasactivities": true,
        "activities": [],
        "detailsreviewnote": null,
        "supportmaterialreviewnote": null,
        "supplementarymaterialreviewnote": null,
        "interactiontoolsreviewnote": null,
        "notesreviewnote": null
    }
}}
<div class="syllabus-week-read border rounded p-3 mb-3">
    <h4>
        {{title}}
        {{#startdate}}
        <small class="text-muted">
            — {{#userdate}} {{startdate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}
            {{#enddate}}a {{#userdate}} {{enddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/enddate}}
        </small>
        {{/startdate}}
        {{#duration}}<small class="text-muted"> · {{duration}} {{#str}} weekduration, mod_syllabus {{/str}}</small>{{/duration}}
    </h4>

    {{#details}}<div class="syllabus-details mb-2">{{{details}}}</div>{{/details}}
    {{#canreview}}{{#detailsreviewnote}}{{> mod_syllabus/review_note_row }}{{/detailsreviewnote}}{{/canreview}}

    {{#hassync}}
    <div class="alert alert-info syllabus-sync-meeting">
        <strong>{{#str}} syncmeeting, mod_syllabus {{/str}}:</strong>
        {{#syncdate}}{{#userdate}} {{syncdate}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}{{/syncdate}}
        {{#synclink}} — <a href="{{synclink}}">{{synclink}}</a>{{/synclink}}
        {{#synctopic}} — {{synctopic}}{{/synctopic}}
    </div>
    {{/hassync}}

    {{#supportmaterial}}
    <div class="syllabus-supportmaterial mb-2">
        <strong>{{#str}} supportmaterial, mod_syllabus {{/str}}:</strong>
        {{{supportmaterial}}}
    </div>
    {{/supportmaterial}}
    {{#canreview}}{{#supportmaterialreviewnote}}{{> mod_syllabus/review_note_row }}{{/supportmaterialreviewnote}}{{/canreview}}
    {{#supplementarymaterial}}
    <div class="syllabus-supplementarymaterial mb-2">
        <strong>{{#str}} supplementarymaterial, mod_syllabus {{/str}}:</strong>
        {{{supplementarymaterial}}}
    </div>
    {{/supplementarymaterial}}
    {{#canreview}}{{#supplementarymaterialreviewnote}}{{> mod_syllabus/review_note_row }}{{/supplementarymaterialreviewnote}}{{/canreview}}

    {{#showtutorfields}}
        {{#interactiontools}}
        <div class="alert alert-secondary">
            <strong>{{#str}} interactiontools, mod_syllabus {{/str}}:</strong>
            <div>{{{interactiontools}}}</div>
        </div>
        {{/interactiontools}}
        {{#canreview}}{{#interactiontoolsreviewnote}}{{> mod_syllabus/review_note_row }}{{/interactiontoolsreviewnote}}{{/canreview}}
        {{#notes}}
        <div class="alert alert-secondary">
            <strong>{{#str}} notes, mod_syllabus {{/str}}:</strong>
            <div>{{{notes}}}</div>
        </div>
        {{/notes}}
        {{#canreview}}{{#notesreviewnote}}{{> mod_syllabus/review_note_row }}{{/notesreviewnote}}{{/canreview}}
    {{/showtutorfields}}

    {{#hasactivities}}
    <h5 class="mt-3">{{#str}} activities, mod_syllabus {{/str}}</h5>
    {{#activities}}
        {{> mod_syllabus/plan_activity_read }}
    {{/activities}}
    {{/hasactivities}}
</div>
