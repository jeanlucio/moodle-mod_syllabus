<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/syllabus/db" VERSION="20260731" COMMENT="XMLDB file for mod_syllabus"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="syllabus" COMMENT="Each record is one Syllabus activity instance">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course this activity belongs to"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft|submitted|approved|changes_requested"/>
        <FIELD NAME="submittedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to user - author who last submitted the plan"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to user - coordinator who last reviewed the plan"/>
        <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="changesrequestedreason" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Coordinator justification when status is changes_requested"/>
        <FIELD NAME="unpublishedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to user - who last pulled an approved plan back to draft"/>
        <FIELD NAME="timeunpublished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="academicperiod" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Characterisation: academic year/term, e.g. 2026.1"/>
        <FIELD NAME="coursestartdate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Characterisation: course period start"/>
        <FIELD NAME="courseenddate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Characterisation: course period end"/>
        <FIELD NAME="totalduration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Characterisation: declared total workload in hours, target for the totals bar"/>
        <FIELD NAME="presentationvideourl" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher and course presentation video link"/>
        <FIELD NAME="stagecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Number of independent 100-point grading stages this plan is divided into"/>
        <FIELD NAME="grademethod" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="sum" SEQUENCE="false" COMMENT="How stage grades are meant to be combined when stagecount &gt; 1: sum|average - informational only, never computes an actual grade"/>
        <FIELD NAME="finalassessmenttitle" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Final assessment: activity title"/>
        <FIELD NAME="finalassessmenttype" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Final assessment: activity type, e.g. forum, quiz, assignment"/>
        <FIELD NAME="finalassessmentstartdate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Final assessment: start date"/>
        <FIELD NAME="finalassessmentenddate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Final assessment: end date"/>
        <FIELD NAME="finalassessmentpoints" TYPE="number" LENGTH="10" NOTNULL="false" SEQUENCE="false" DECIMALS="2" COMMENT="Final assessment: points, typically 100"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="fk_submittedby" TYPE="foreign" FIELDS="submittedby" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_reviewedby" TYPE="foreign" FIELDS="reviewedby" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_unpublishedby" TYPE="foreign" FIELDS="unpublishedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="syllabus_weeks" COMMENT="Weeks that compose a syllabus plan">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="syllabusid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to syllabus instance"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Duration in hours"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="syncdate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Synchronous meeting date and time"/>
        <FIELD NAME="synclink" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Synchronous meeting access link"/>
        <FIELD NAME="synctopic" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Synchronous meeting topic"/>
        <FIELD NAME="stage" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Which grading stage (1..syllabus.stagecount) this week's activities count toward"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_syllabus" TYPE="foreign" FIELDS="syllabusid" REFTABLE="syllabus" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="syllabus_activities" COMMENT="Activities that compose a week, feeding the consolidated schedule">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="weekid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to syllabus_weeks"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="type" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Forum, quiz, assignment, etc."/>
        <FIELD NAME="category" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Synchronous, asynchronous, online"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="points" TYPE="number" LENGTH="10" NOTNULL="false" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_week" TYPE="foreign" FIELDS="weekid" REFTABLE="syllabus_weeks" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="syllabus_review_notes" COMMENT="Coordinator observations left on a specific narrative field, cleared on approval">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="syllabusid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to syllabus instance"/>
        <FIELD NAME="area" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="plan|week|activity - which Custom Field area the field belongs to"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="syllabus.id, syllabus_weeks.id or syllabus_activities.id depending on area"/>
        <FIELD NAME="fieldid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to customfield_field - the narrative field this note is about"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to user - coordinator who wrote this note; nullable like syllabus.reviewedby, e.g. after a userinfo-less restore"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_syllabus" TYPE="foreign" FIELDS="syllabusid" REFTABLE="syllabus" REFFIELDS="id"/>
        <KEY NAME="fk_reviewer" TYPE="foreign" FIELDS="reviewerid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
