{{!
    @template mod_syllabus/review_note_row

    One coordinator review-note box for a single narrative field, rendered inline directly
    under that field's own read-only content (plan_week_read.mustache, plan_activity_read.mustache,
    plan_final_assessment.mustache, tab_full_plan.mustache's read branch) — never a standalone
    panel. The label is a fixed "Coordinator note" string rather than the field's own name:
    the field's heading already sits immediately above this box, so repeating its name here
    would be redundant.

    Example context (json):
    {
        "fieldid": 5,
        "instanceid": 10,
        "area": "week",
        "coordinatornote": "Please expand this section with more examples."
    }
}}
<div class="alert alert-warning syllabus-review-note-row mb-2"
    data-area="{{area}}" data-instanceid="{{instanceid}}" data-fieldid="{{fieldid}}">
    <label class="form-label small mb-1" for="syllabus-review-note-{{area}}-{{instanceid}}-{{fieldid}}">
        {{#str}} reviewnote, mod_syllabus {{/str}}
    </label>
    <textarea id="syllabus-review-note-{{area}}-{{instanceid}}-{{fieldid}}"
        class="form-control form-control-sm syllabus-review-note-input" rows="2"
        placeholder="{{#str}} reviewnoteplaceholder, mod_syllabus {{/str}}">{{coordinatornote}}</textarea>
    <span class="syllabus-review-note-status d-none small text-muted"
        data-saved="{{#str}} reviewnotesaved, mod_syllabus {{/str}}"
        data-saving="{{#str}} saving, mod_syllabus {{/str}}"></span>
</div>
