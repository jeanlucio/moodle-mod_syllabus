{{!
    @template mod_syllabus/student_view

    Plano de Disciplina do Aluno view. Never receives grading criteria/gabarito or tutor
    accompaniment notes — those fields are simply never exported into this template's data.

    Example context (json):
    {
        "ementa": "<p>Course description text.</p>",
        "objetivos": "<p>Course objectives text.</p>",
        "conteudos": "<p>Course contents text.</p>",
        "metodologia": "<p>Course methodology text.</p>"
    }
}}
<div class="path-mod-syllabus">
    <h3>{{#str}} ementa, mod_syllabus {{/str}}</h3>
    <div class="syllabus-ementa">{{{ementa}}}</div>

    <h3>{{#str}} objetivos, mod_syllabus {{/str}}</h3>
    <div class="syllabus-objetivos">{{{objetivos}}}</div>

    <h3>{{#str}} conteudos, mod_syllabus {{/str}}</h3>
    <div class="syllabus-conteudos">{{{conteudos}}}</div>

    <h3>{{#str}} metodologia, mod_syllabus {{/str}}</h3>
    <div class="syllabus-metodologia">{{{metodologia}}}</div>

    <h3>{{#str}} aulas, mod_syllabus {{/str}}</h3>
    <p class="text-muted">{{#str}} noaulasyet, mod_syllabus {{/str}}</p>
</div>
