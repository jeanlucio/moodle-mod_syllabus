{{!
    @template mod_syllabus/plan_schedule

    The "Cronograma de Atividades e Pontuação" table present in all 3 source documents —
    computed fresh from the activities each time, never persisted. Shared by all 3 tabs.

    Example context (json):
    {
        "hasschedule": true,
        "schedule": [
            {"weektitle": "Semana 1", "type": "forum", "category": "online", "title": "Fórum 1", "points": 15, "enddate": 1749600000}
        ]
    }
}}
{{#hasschedule}}
<h4 class="mt-4">{{#str}} schedule, mod_syllabus {{/str}}</h4>
<div class="table-responsive">
    <table class="table table-sm syllabus-schedule">
        <thead>
            <tr>
                <th scope="col">{{#str}} week, mod_syllabus {{/str}}</th>
                <th scope="col">{{#str}} activitytype, mod_syllabus {{/str}}</th>
                <th scope="col">{{#str}} activitycategory, mod_syllabus {{/str}}</th>
                <th scope="col">{{#str}} activitytitle, mod_syllabus {{/str}}</th>
                <th scope="col">{{#str}} activitypoints, mod_syllabus {{/str}}</th>
                <th scope="col">{{#str}} deadline, mod_syllabus {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#schedule}}
            <tr>
                <td>{{weektitle}}</td>
                <td>{{type}}</td>
                <td>{{category}}</td>
                <td>{{title}}</td>
                <td>{{points}}</td>
                <td>
                    {{#enddate}}{{#userdate}} {{enddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/enddate}}
                </td>
            </tr>
            {{/schedule}}
        </tbody>
    </table>
</div>
{{/hasschedule}}
