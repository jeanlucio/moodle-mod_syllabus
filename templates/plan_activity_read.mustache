{{!
    @template mod_syllabus/plan_activity_read

    One activity, read-only. Shared by the student and tutor tabs (and Tab 1's read-only
    branch) — showtutorfields controls whether grading criteria/tutor guidance are shown.
    Never receives those two properties at all when the caller is the student tab, so there
    is nothing to accidentally leak here regardless of this template's own logic.

    The coordinator's review notes are rendered inline right below each narrative field, via
    the ...reviewnote objects — see plan_week_read.mustache for the full rationale (same
    context-stack-fallback pattern for canreview, same null/missing-by-default safety for the
    student/tutor tabs). The same fallback carries the "changed since last review" indicators
    (isnew/structurechanged/...changed) — see plan_snapshot.

    Example context (json):
    {
        "title": "Graded Forum 1",
        "type": "forum",
        "category": "online",
        "startdate": 1749000000,
        "enddate": 1749600000,
        "points": 15,
        "studentinstructions": "<p>Read the chapter and reply in the forum.</p>",
        "showtutorfields": true,
        "gradingcriteria": "<p>4 pts clarity, 4 pts argumentation...</p>",
        "tutorguidance": "<p>Review posts and assign points using the rubric.</p>",
        "studentinstructionsreviewnote": null,
        "gradingcriteriareviewnote": null,
        "tutorguidancereviewnote": null,
        "isnew": false,
        "structurechanged": false,
        "studentinstructionschanged": false,
        "gradingcriteriachanged": false,
        "tutorguidancechanged": false
    }
}}
<div class="syllabus-activity-read border rounded p-2 mb-2">
    <h5 class="mb-1">
        {{title}}
        {{#canreview}}
            {{#isnew}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} newsincereview, mod_syllabus {{/str}}</span>{{/isnew}}
            {{^isnew}}{{#structurechanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/structurechanged}}{{/isnew}}
        {{/canreview}}
    </h5>
    <p class="small text-muted mb-2">
        {{#type}}{{type}}{{/type}}{{#category}} · {{category}}{{/category}}
        {{#startdate}}
            · {{#userdate}} {{startdate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}
            {{#enddate}}– {{#userdate}} {{enddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/enddate}}
        {{/startdate}}
        {{#points}} · {{points}} {{#str}} activitypoints, mod_syllabus {{/str}}{{/points}}
    </p>
    {{#canreview}}{{#studentinstructionschanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/studentinstructionschanged}}{{/canreview}}
    {{#studentinstructions}}
    <div class="syllabus-studentinstructions">{{{studentinstructions}}}</div>
    {{/studentinstructions}}
    {{#canreview}}{{#studentinstructionsreviewnote}}{{> mod_syllabus/review_note_row }}{{/studentinstructionsreviewnote}}{{/canreview}}
    {{#showtutorfields}}
        {{#canreview}}{{#gradingcriteriachanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/gradingcriteriachanged}}{{/canreview}}
        {{#gradingcriteria}}
        <div class="alert alert-secondary mt-2 mb-0">
            <strong>{{#str}} gradingcriteria, mod_syllabus {{/str}}:</strong>
            <div>{{{gradingcriteria}}}</div>
        </div>
        {{/gradingcriteria}}
        {{#canreview}}{{#gradingcriteriareviewnote}}{{> mod_syllabus/review_note_row }}{{/gradingcriteriareviewnote}}{{/canreview}}
        {{#canreview}}{{#tutorguidancechanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/tutorguidancechanged}}{{/canreview}}
        {{#tutorguidance}}
        <div class="alert alert-secondary mt-2 mb-0">
            <strong>{{#str}} tutorguidance, mod_syllabus {{/str}}:</strong>
            <div>{{{tutorguidance}}}</div>
        </div>
        {{/tutorguidance}}
        {{#canreview}}{{#tutorguidancereviewnote}}{{> mod_syllabus/review_note_row }}{{/tutorguidancereviewnote}}{{/canreview}}
    {{/showtutorfields}}
</div>
