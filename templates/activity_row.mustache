{{!
    @template mod_syllabus/activity_row

    One activity within a week's editable list: structural fields form plus its narrative
    Custom Field editors. Only rendered inside tab_full_plan for the author. Structural
    fields autosave on change (amd/src/weeks_manager.js) — there is no per-row "Save" button;
    only "Delete" remains.

    structuralhelp (activitytype/finalassessment keys) is set once on tab_full_plan's own
    context and read here via Mustache's normal context-stack fallback (same pattern as
    tinyavailable in narrative_field.mustache) — each value is pre-rendered HTML from the
    'help' Custom Field area (plan_reader::structural_help()), institution-editable via
    managefields.php.

    Example context (json):
    {
        "id": 5,
        "weekid": 2,
        "title": "Forum kickoff",
        "type": "forum",
        "category": "asynchronous",
        "points": 10,
        "isfinalassessment": false,
        "startdatefield": {
            "fieldid": "syllabus-activity-startdate-5",
            "fieldclass": "syllabus-activity-startdate",
            "labeltext": "Start date",
            "timestamp": 1749000000
        },
        "enddatefield": {
            "fieldid": "syllabus-activity-enddate-5",
            "fieldclass": "syllabus-activity-enddate",
            "labeltext": "End date",
            "timestamp": 1749600000
        },
        "typeoptions": [
            {"value": "forum", "label": "Forum", "selected": true},
            {"value": "quiz", "label": "Quiz", "selected": false}
        ],
        "categoryoptions": [
            {"value": "asynchronous", "label": "Asynchronous", "selected": true},
            {"value": "online", "label": "Online", "selected": false}
        ],
        "structuralhelp": {
            "activitytype": "<p>Choose the LMS tool used...</p>",
            "finalassessment": "<p>Mark the activity that represents the Final assessment...</p>"
        },
        "fields": [
            {
                "fieldid": 3,
                "instanceid": 5,
                "elementid": "syllabus-field-5-3",
                "name": "Student instructions",
                "text": "",
                "itemid": 12,
                "area": "activity",
                "isplanfield": false,
                "description": "<p>Explain to the student what to do and how to complete this activity.</p>"
            }
        ]
    }
}}
<div class="syllabus-activity-row border rounded p-2 mb-2" data-activityid="{{id}}" data-weekid="{{weekid}}">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1" for="syllabus-activity-title-{{id}}">
                {{#str}} activitytitle, mod_syllabus {{/str}}
            </label>
            <input type="text" class="form-control syllabus-activity-title" id="syllabus-activity-title-{{id}}"
                value="{{title}}" placeholder="{{#str}} activitytitle, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="syllabus-activity-type-{{id}}">
                {{#str}} activitytype, mod_syllabus {{/str}}
            </label>
            <select class="form-select syllabus-activity-type" id="syllabus-activity-type-{{id}}">
                <option value="">{{#str}} choosedots, core {{/str}}</option>
                {{#typeoptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/typeoptions}}
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="syllabus-activity-category-{{id}}">
                {{#str}} activitycategory, mod_syllabus {{/str}}
            </label>
            <select class="form-select syllabus-activity-category" id="syllabus-activity-category-{{id}}">
                <option value="">{{#str}} choosedots, core {{/str}}</option>
                {{#categoryoptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/categoryoptions}}
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="syllabus-activity-points-{{id}}">
                {{#str}} activitypoints, mod_syllabus {{/str}}
            </label>
            <input type="number" step="0.01" class="form-control syllabus-activity-points"
                id="syllabus-activity-points-{{id}}" value="{{points}}"
                placeholder="{{#str}} activitypoints, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2 text-end">
            <span class="syllabus-save-status syllabus-activity-save-status d-none small text-muted me-2"
                data-saving="{{#str}} saving, mod_syllabus {{/str}}"
                data-saved="{{#str}} saved, mod_syllabus {{/str}}"></span>
            <button type="button" class="btn btn-sm btn-outline-danger syllabus-delete-activity"
                data-confirm="{{#str}} confirmdeleteactivity, mod_syllabus {{/str}}">
                {{#str}} delete, core {{/str}}
            </button>
        </div>
    </div>
    <div class="mt-1">{{{structuralhelp.activitytype}}}</div>
    <div class="row g-2 align-items-center mt-2">
        <div class="col-md-3">
            {{#startdatefield}}{{> mod_syllabus/date_select }}{{/startdatefield}}
        </div>
        <div class="col-md-3">
            {{#enddatefield}}{{> mod_syllabus/date_select }}{{/enddatefield}}
        </div>
        <div class="col-md-6 form-check pt-1">
            <input type="checkbox" class="form-check-input syllabus-activity-isfinalassessment"
                id="syllabus-activity-isfinalassessment-{{id}}" {{#isfinalassessment}}checked{{/isfinalassessment}}>
            <label class="form-check-label" for="syllabus-activity-isfinalassessment-{{id}}">
                {{#str}} finalassessment, mod_syllabus {{/str}}
            </label>
        </div>
    </div>
    <div class="mt-1 mb-2">{{{structuralhelp.finalassessment}}}</div>
    {{#fields}}
        {{> mod_syllabus/narrative_field }}
    {{/fields}}
</div>
