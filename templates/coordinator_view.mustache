{{!
    @template mod_syllabus/coordinator_view

    Full plan view shown to the teacher (author) and to the coordination (reviewer). The
    author (caneditcontent) gets the editable weeks/activities management UI with narrative
    Custom Field autosave; a reviewer without mod/syllabus:submit sees the same read-only
    content as before — submit/review actions themselves are wired in a later phase.

    Example context (json):
    {
        "cmid": 42,
        "statuslabel": "Draft",
        "statusbadgeclass": "bg-secondary",
        "caneditcontent": true,
        "coursedescription": "<p>Course description text.</p>",
        "objectives": "<p>Course objectives text.</p>",
        "contents": "<p>Course contents text.</p>",
        "methodology": "<p>Course methodology text.</p>",
        "planfields": [
            {
                "fieldid": 1,
                "instanceid": 3,
                "elementid": "syllabus-field-3-1",
                "name": "Course description",
                "text": "<p>Course description text.</p>",
                "itemid": 15
            }
        ],
        "weeks": [],
        "hasweeks": false,
        "cansubmit": true,
        "canreviewnow": false,
        "canunpublish": false,
        "changesrequestedreason": null
    }
}}
<div class="path-mod-syllabus" data-cmid="{{cmid}}">
    <div class="syllabus-status mb-3">
        <span class="badge {{statusbadgeclass}} syllabus-status-badge">{{statuslabel}}</span>
    </div>

    {{#caneditcontent}}
        {{#planfields}}
        <div class="syllabus-field mb-3">
            <h3><label for="{{elementid}}">{{name}}</label></h3>
            <textarea id="{{elementid}}" class="syllabus-customfield-editor" data-fieldid="{{fieldid}}"
                data-instanceid="{{instanceid}}" data-area="plan" data-itemid="{{itemid}}">{{text}}</textarea>
            <span class="syllabus-save-status d-none small text-muted"
                data-saving="{{#str}} saving, mod_syllabus {{/str}}"
                data-saved="{{#str}} saved, mod_syllabus {{/str}}"></span>
        </div>
        {{/planfields}}

        <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
        <div class="syllabus-weeks-list">
            {{#weeks}}
                {{> mod_syllabus/week_row }}
            {{/weeks}}
        </div>
        {{^hasweeks}}
        <p class="text-muted syllabus-noweeksyet">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
        {{/hasweeks}}
        <button type="button" class="btn btn-outline-secondary syllabus-add-week">
            {{#str}} addweek, mod_syllabus {{/str}}
        </button>
    {{/caneditcontent}}

    {{^caneditcontent}}
        <h3>{{#str}} coursedescription, mod_syllabus {{/str}}</h3>
        <div class="syllabus-coursedescription">{{{coursedescription}}}</div>

        <h3>{{#str}} objectives, mod_syllabus {{/str}}</h3>
        <div class="syllabus-objectives">{{{objectives}}}</div>

        <h3>{{#str}} contents, mod_syllabus {{/str}}</h3>
        <div class="syllabus-contents">{{{contents}}}</div>

        <h3>{{#str}} methodology, mod_syllabus {{/str}}</h3>
        <div class="syllabus-methodology">{{{methodology}}}</div>

        <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
        <p class="text-muted">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
    {{/caneditcontent}}

    {{#changesrequestedreason}}
    <div class="alert alert-warning syllabus-changes-requested-reason">
        <strong>{{#str}} changesrequestedreason, mod_syllabus {{/str}}:</strong> {{changesrequestedreason}}
    </div>
    {{/changesrequestedreason}}

    <div class="syllabus-workflow-actions mt-4">
        {{#cansubmit}}
        <button type="button" class="btn btn-primary syllabus-submit-plan">
            {{#str}} submitforreview, mod_syllabus {{/str}}
        </button>
        {{/cansubmit}}

        {{#canreviewnow}}
        <div class="syllabus-review-panel border rounded p-3">
            <button type="button" class="btn btn-success syllabus-approve-plan">
                {{#str}} approve, core {{/str}}
            </button>
            <div class="syllabus-request-changes-form mt-2">
                <label for="syllabus-changes-reason">{{#str}} reasonforchanges, mod_syllabus {{/str}}</label>
                <textarea id="syllabus-changes-reason" class="form-control syllabus-changes-reason" rows="3"></textarea>
                <button type="button" class="btn btn-warning mt-2 syllabus-request-changes">
                    {{#str}} requestchanges, mod_syllabus {{/str}}
                </button>
            </div>
        </div>
        {{/canreviewnow}}

        {{#canunpublish}}
        <button type="button" class="btn btn-outline-danger syllabus-unpublish"
            data-confirm="{{#str}} confirmunpublish, mod_syllabus {{/str}}">
            {{#str}} unpublish, mod_syllabus {{/str}}
        </button>
        {{/canunpublish}}
    </div>
</div>
