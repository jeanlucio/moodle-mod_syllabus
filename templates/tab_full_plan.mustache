<div class="path-mod-syllabus syllabus-tab-full" data-cmid="{{cmid}}">
    <div class="syllabus-status mb-3">
        <span class="badge {{statusbadgeclass}} syllabus-status-badge">{{statuslabel}}</span>
    </div>

    {{#caneditcontent}}
    <div class="syllabus-edit-layout">
        <nav class="syllabus-nav-rail" aria-label="{{#str}} sectionnavigation, mod_syllabus {{/str}}">
            <a href="#syllabus-section-characterisation" class="syllabus-rail-link">
                <span class="syllabus-rail-icon" aria-hidden="true">○</span>
                <span class="visually-hidden syllabus-rail-icon-text"></span>
                {{#str}} characterisation, mod_syllabus {{/str}}
            </a>
            {{#planfields}}
            <a href="#syllabus-section-field-{{fieldid}}" class="syllabus-rail-link">
                <span class="syllabus-rail-icon" aria-hidden="true">○</span>
                <span class="visually-hidden syllabus-rail-icon-text"></span>
                {{name}}
            </a>
            {{/planfields}}
            {{#weeks}}
            <a href="#syllabus-section-week-{{id}}" class="syllabus-rail-link">
                <span class="syllabus-rail-icon" aria-hidden="true">○</span>
                <span class="visually-hidden syllabus-rail-icon-text"></span>
                {{#title}}{{title}}{{/title}}
                {{^title}}{{#str}} addweek, mod_syllabus {{/str}}{{/title}}
            </a>
            {{/weeks}}
            <a href="#syllabus-section-finalassessment" class="syllabus-rail-link">
                <span class="syllabus-rail-icon" aria-hidden="true">○</span>
                <span class="visually-hidden syllabus-rail-icon-text"></span>
                {{#str}} finalassessment, mod_syllabus {{/str}}
            </a>
        </nav>

        <div class="syllabus-edit-content">
            {{#tinyavailable}}
            <script type="application/json" id="syllabus-tiny-config">{{{tinyconfig}}}</script>
            {{/tinyavailable}}
            <div class="syllabus-totals-bar">
                <span class="syllabus-totals-duration">
                    {{#str}} totalworkload, mod_syllabus {{/str}}:
                    <strong class="syllabus-totals-duration-value">0</strong> /
                    <strong class="syllabus-totals-duration-target">{{totalduration}}</strong>
                </span>
                {{#stages}}
                <span class="syllabus-totals-points" data-stage="{{stagenum}}">
                    {{#str}} activitypoints, mod_syllabus {{/str}}
                    {{#hasmultiplestages}}({{#str}} stagen, mod_syllabus, {{stagenum}} {{/str}}){{/hasmultiplestages}}:
                    <strong class="syllabus-totals-points-value">0</strong> / 100
                </span>
                {{/stages}}
                <span class="syllabus-totals-grademethod {{^hasmultiplestages}}d-none{{/hasmultiplestages}}">
                    {{#str}} grademethod, mod_syllabus {{/str}}:
                    <span class="syllabus-totals-grademethod-value"></span>
                </span>
                <span class="syllabus-totals-counts">
                    <strong class="syllabus-totals-weeks-value">0</strong> {{#str}} weeks, mod_syllabus {{/str}} ·
                    <strong class="syllabus-totals-activities-value">0</strong> {{#str}} activities, mod_syllabus {{/str}}
                </span>
                <span class="syllabus-totals-autosave" data-idle="{{#str}} allchangessaved, mod_syllabus {{/str}}"
                    data-pending="{{#str}} saving, mod_syllabus {{/str}}">
                    {{#str}} allchangessaved, mod_syllabus {{/str}}
                </span>
                <span class="syllabus-totals-spacer"></span>
                <button type="button" class="btn btn-link btn-sm syllabus-collapse-all"
                    data-collapse="{{#str}} collapseall, mod_syllabus {{/str}}"
                    data-expand="{{#str}} expandall, mod_syllabus {{/str}}">
                    {{#str}} collapseall, mod_syllabus {{/str}}
                </button>
            </div>

            <div id="syllabus-section-characterisation" data-syllabus-section>
                <h3>{{#str}} characterisation, mod_syllabus {{/str}}</h3>
                <div class="row g-2 syllabus-characterisation-edit mb-3">
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="syllabus-plan-academicperiod">
                            {{#str}} academicperiod, mod_syllabus {{/str}}
                        </label>
                        <input type="text" class="form-control syllabus-plan-academicperiod syllabus-required-input"
                            id="syllabus-plan-academicperiod" value="{{academicperiod}}"
                            placeholder="{{#str}} academicperiod, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-4">
                        {{#coursestartdatefield}}{{> mod_syllabus/date_select }}{{/coursestartdatefield}}
                    </div>
                    <div class="col-md-4">
                        {{#courseenddatefield}}{{> mod_syllabus/date_select }}{{/courseenddatefield}}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="syllabus-plan-totalduration">
                            {{#str}} totalworkload, mod_syllabus {{/str}}
                        </label>
                        <input type="number" class="form-control syllabus-plan-totalduration syllabus-required-input"
                            id="syllabus-plan-totalduration" value="{{totalduration}}"
                            placeholder="{{#str}} totalworkload, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small mb-1" for="syllabus-plan-presentationvideourl">
                            {{#str}} presentationvideo, mod_syllabus {{/str}}
                        </label>
                        <input type="url" class="form-control syllabus-plan-presentationvideourl"
                            id="syllabus-plan-presentationvideourl" value="{{presentationvideourl}}"
                            placeholder="{{#str}} presentationvideo, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1" for="syllabus-plan-stagecount">
                            {{#str}} stagecount, mod_syllabus {{/str}}
                        </label>
                        <input type="number" min="1" class="form-control syllabus-plan-stagecount"
                            id="syllabus-plan-stagecount" value="{{stagecount}}"
                            placeholder="{{#str}} stagecount, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-2 {{^hasmultiplestages}}d-none{{/hasmultiplestages}}">
                        <label class="form-label small mb-1" for="syllabus-plan-grademethod">
                            {{#str}} grademethod, mod_syllabus {{/str}}
                        </label>
                        <select class="form-select syllabus-plan-grademethod" id="syllabus-plan-grademethod">
                            {{#grademethodoptions}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/grademethodoptions}}
                        </select>
                    </div>
                </div>
                <div class="mb-3">{{{structuralhelp.characterisation}}}</div>
            </div>

            {{#planfields}}
                {{> mod_syllabus/narrative_field }}
            {{/planfields}}

            <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
            <div class="syllabus-weeks-list">
                {{#weeks}}
                    {{> mod_syllabus/week_row }}
                {{/weeks}}
            </div>
            <button type="button" class="btn btn-outline-secondary syllabus-add-week">
                {{#str}} addweek, mod_syllabus {{/str}}
            </button>

            <div id="syllabus-section-finalassessment" data-syllabus-section class="mt-4">
                <h3>{{#str}} finalassessment, mod_syllabus {{/str}}</h3>
                <div class="row g-2 mb-2 syllabus-finalassessment-edit">
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="syllabus-plan-finalassessmenttitle">
                            {{#str}} finalassessmenttitle, mod_syllabus {{/str}}
                        </label>
                        <input type="text" class="form-control syllabus-plan-finalassessmenttitle syllabus-required-input"
                            id="syllabus-plan-finalassessmenttitle" value="{{finalassessmenttitle}}"
                            placeholder="{{#str}} finalassessmenttitle, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1" for="syllabus-plan-finalassessmenttype">
                            {{#str}} finalassessmenttype, mod_syllabus {{/str}}
                        </label>
                        <select class="form-select syllabus-plan-finalassessmenttype syllabus-required-input" id="syllabus-plan-finalassessmenttype">
                            <option value="">{{#str}} choosedots, core {{/str}}</option>
                            {{#finalassessmenttypeoptions}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/finalassessmenttypeoptions}}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1" for="syllabus-plan-finalassessmentpoints">
                            {{#str}} finalassessmentpoints, mod_syllabus {{/str}}
                        </label>
                        <input type="number" step="0.01" class="form-control syllabus-plan-finalassessmentpoints syllabus-required-input"
                            id="syllabus-plan-finalassessmentpoints" value="{{finalassessmentpoints}}"
                            placeholder="{{#str}} finalassessmentpoints, mod_syllabus {{/str}}">
                    </div>
                    <div class="col-md-6">
                        {{#finalassessmentstartdatefield}}{{> mod_syllabus/date_select }}{{/finalassessmentstartdatefield}}
                    </div>
                    <div class="col-md-6">
                        {{#finalassessmentenddatefield}}{{> mod_syllabus/date_select }}{{/finalassessmentenddatefield}}
                    </div>
                </div>
                <div class="mb-3">{{{structuralhelp.finalassessment}}}</div>
            </div>
            {{#finalassessmentfield}}
                {{> mod_syllabus/narrative_field }}
            {{/finalassessmentfield}}
        </div>
    </div>
    {{/caneditcontent}}

    {{^caneditcontent}}
        <h3>
            {{#str}} characterisation, mod_syllabus {{/str}}
            {{#canreview}}{{#characterisationchanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/characterisationchanged}}{{/canreview}}
        </h3>
        <div class="syllabus-characterisation-grid mb-3">
            <div>
                <span class="syllabus-grid-label">{{#str}} studyprogram, mod_syllabus {{/str}}</span>
                {{coursename}}
            </div>
            <div>
                <span class="syllabus-grid-label">{{#str}} discipline, mod_syllabus {{/str}}</span>
                {{disciplinename}}
            </div>
            <div>
                <span class="syllabus-grid-label">{{#str}} teacher, mod_syllabus {{/str}}</span>
                {{teachername}}
            </div>
            <div>
                <span class="syllabus-grid-label">{{#str}} academicperiod, mod_syllabus {{/str}}</span>
                {{academicperiod}}
            </div>
            {{#coursestartdate}}
            <div>
                <span class="syllabus-grid-label">{{#str}} courseperiod, mod_syllabus {{/str}}</span>
                {{#userdate}} {{coursestartdate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}
                {{#courseenddate}}– {{#userdate}} {{courseenddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/courseenddate}}
            </div>
            {{/coursestartdate}}
            {{#totalduration}}
            <div>
                <span class="syllabus-grid-label">{{#str}} totalworkload, mod_syllabus {{/str}}</span>
                {{totalduration}}
            </div>
            {{/totalduration}}
        </div>

        <h3>{{#str}} coursedescription, mod_syllabus {{/str}}</h3>
        {{#canreview}}{{#coursedescriptionchanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/coursedescriptionchanged}}{{/canreview}}
        <div class="syllabus-coursedescription mb-2">{{{coursedescription}}}</div>
        {{#canreview}}{{#coursedescriptionreviewnote}}{{> mod_syllabus/review_note_row }}{{/coursedescriptionreviewnote}}{{/canreview}}

        <h3>{{#str}} objectives, mod_syllabus {{/str}}</h3>
        {{#canreview}}{{#objectiveschanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/objectiveschanged}}{{/canreview}}
        <div class="syllabus-objectives mb-2">{{{objectives}}}</div>
        {{#canreview}}{{#objectivesreviewnote}}{{> mod_syllabus/review_note_row }}{{/objectivesreviewnote}}{{/canreview}}

        <h3>{{#str}} contents, mod_syllabus {{/str}}</h3>
        {{#canreview}}{{#contentschanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/contentschanged}}{{/canreview}}
        <div class="syllabus-contents mb-2">{{{contents}}}</div>
        {{#canreview}}{{#contentsreviewnote}}{{> mod_syllabus/review_note_row }}{{/contentsreviewnote}}{{/canreview}}

        <h3>{{#str}} methodology, mod_syllabus {{/str}}</h3>
        {{#canreview}}{{#methodologychanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/methodologychanged}}{{/canreview}}
        <div class="syllabus-methodology mb-2">{{{methodology}}}</div>
        {{#canreview}}{{#methodologyreviewnote}}{{> mod_syllabus/review_note_row }}{{/methodologyreviewnote}}{{/canreview}}

        {{#presentationscript}}
        <h3>{{#str}} presentationscript, mod_syllabus {{/str}}</h3>
        <div class="syllabus-presentationscript mb-2">{{{presentationscript}}}</div>
        {{/presentationscript}}
        {{#canreview}}{{#presentationscriptchanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/presentationscriptchanged}}{{/canreview}}
        {{#canreview}}{{#presentationscriptreviewnote}}{{> mod_syllabus/review_note_row }}{{/presentationscriptreviewnote}}{{/canreview}}

        <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
        {{#hasweeks}}
            {{#readweeks}}
                {{> mod_syllabus/plan_week_read }}
            {{/readweeks}}
        {{/hasweeks}}
        {{^hasweeks}}
        <p class="text-muted">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
        {{/hasweeks}}

        {{> mod_syllabus/plan_final_assessment }}

        {{#generalreferences}}
        <h3>{{#str}} generalreferences, mod_syllabus {{/str}}</h3>
        <div class="syllabus-generalreferences mb-2">{{{generalreferences}}}</div>
        {{/generalreferences}}
        {{#canreview}}{{#generalreferenceschanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/generalreferenceschanged}}{{/canreview}}
        {{#canreview}}{{#generalreferencesreviewnote}}{{> mod_syllabus/review_note_row }}{{/generalreferencesreviewnote}}{{/canreview}}

        {{> mod_syllabus/plan_schedule }}
    {{/caneditcontent}}

    {{#changesrequestedreason}}
    <div class="alert alert-warning syllabus-changes-requested-reason">
        <strong>{{#str}} changesrequestedreason, mod_syllabus {{/str}}:</strong> {{changesrequestedreason}}
    </div>
    {{/changesrequestedreason}}

    {{#resubmissionnote}}
    <div class="alert alert-info syllabus-resubmission-note-display">
        <strong>{{#str}} resubmissionnote, mod_syllabus {{/str}}:</strong> {{resubmissionnote}}
    </div>
    {{/resubmissionnote}}

    {{#hasremovedsincereview}}
    <div class="alert alert-secondary syllabus-removed-since-review">
        <strong>{{#str}} removedsincereview, mod_syllabus {{/str}}:</strong> {{removedsincereviewlist}}
    </div>
    {{/hasremovedsincereview}}

    <div class="syllabus-workflow-actions mt-4">
        {{#cansubmit}}
            {{#showresubmissionnoteinput}}
            <div class="mb-2">
                <label for="syllabus-resubmission-note" class="form-label">
                    {{#str}} resubmissionnote, mod_syllabus {{/str}}
                </label>
                <textarea id="syllabus-resubmission-note" class="form-control syllabus-resubmission-note" rows="3"
                    placeholder="{{#str}} resubmissionnoteplaceholder, mod_syllabus {{/str}}"></textarea>
            </div>
            {{/showresubmissionnoteinput}}
        <button type="button" class="btn btn-primary syllabus-submit-plan">
            {{#str}} submitforreview, mod_syllabus {{/str}}
        </button>
        {{/cansubmit}}

        {{#canreviewnow}}
        <div class="syllabus-review-panel border rounded p-3">
            <button type="button" class="btn btn-success syllabus-approve-plan">
                {{#str}} approve, core {{/str}}
            </button>
            <div class="syllabus-request-changes-form mt-2">
                <label for="syllabus-changes-reason">{{#str}} reasonforchanges, mod_syllabus {{/str}}</label>
                <textarea id="syllabus-changes-reason" class="form-control syllabus-changes-reason" rows="3"></textarea>
                <button type="button" class="btn btn-warning mt-2 syllabus-request-changes">
                    {{#str}} requestchanges, mod_syllabus {{/str}}
                </button>
            </div>
        </div>
        {{/canreviewnow}}

        {{#canunpublish}}
        <button type="button" class="btn btn-outline-danger syllabus-unpublish"
            data-confirm="{{#str}} confirmunpublish, mod_syllabus {{/str}}">
            {{#str}} unpublish, mod_syllabus {{/str}}
        </button>
        {{/canunpublish}}
    </div>
</div>
