{{!
    @template mod_syllabus/plan_final_assessment

    The "Final assessment" block — a single, plan-level object (plan_read_export::
    final_assessment()), structurally paralleling Characterisation rather than an activity
    inside some week. Shared by the 3 read-only tabs (student, tutor, Tab 1's read-only
    branch) — never rendered in the edit-mode branch, which has its own structured form for
    the same fields plus the narrative Custom Field editor.

    The coordinator's review note for the instructions field is rendered inline right below
    it, via finalassessment.instructionsreviewnote — see plan_week_read.mustache for the full
    rationale (same context-stack-fallback pattern for canreview, same null/missing-by-default
    safety for the student/tutor tabs). The same fallback carries structurechanged/
    instructionschanged — see plan_snapshot.

    Example context (json):
    {
        "hasfinalassessment": true,
        "finalassessment": {
            "title": "Final Exam",
            "type": "quiz",
            "startdate": 1749000000,
            "enddate": 1749600000,
            "points": 100,
            "instructions": "<p>Exam covering the whole semester's content.</p>",
            "instructionsreviewnote": null,
            "structurechanged": false,
            "instructionschanged": false
        }
    }
}}
{{#hasfinalassessment}}
<h3>{{#str}} finalassessment, mod_syllabus {{/str}}</h3>
<div class="syllabus-final-assessment-read border rounded p-2 mb-3">
    <h5 class="mb-1">
        {{finalassessment.title}}
        {{#finalassessment}}
            {{#canreview}}{{#structurechanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/structurechanged}}{{/canreview}}
        {{/finalassessment}}
    </h5>
    <p class="small text-muted mb-2">
        {{#finalassessment.type}}{{finalassessment.type}}{{/finalassessment.type}}
        {{#finalassessment.startdate}}
            · {{#userdate}} {{finalassessment.startdate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}
            {{#finalassessment.enddate}}– {{#userdate}} {{finalassessment.enddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/finalassessment.enddate}}
        {{/finalassessment.startdate}}
        {{#finalassessment.points}} · {{finalassessment.points}} {{#str}} activitypoints, mod_syllabus {{/str}}{{/finalassessment.points}}
    </p>
    {{#finalassessment}}
        {{#canreview}}{{#instructionschanged}}<span class="badge bg-primary syllabus-changed-badge">{{#str}} changedsincereview, mod_syllabus {{/str}}</span>{{/instructionschanged}}{{/canreview}}
    {{/finalassessment}}
    {{#finalassessment.instructions}}
    <div class="syllabus-studentinstructions">{{{finalassessment.instructions}}}</div>
    {{/finalassessment.instructions}}
    {{#finalassessment}}
        {{#canreview}}{{#instructionsreviewnote}}{{> mod_syllabus/review_note_row }}{{/instructionsreviewnote}}{{/canreview}}
    {{/finalassessment}}
</div>
{{/hasfinalassessment}}
