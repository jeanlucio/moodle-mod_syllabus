{{!
    @template mod_syllabus/activity_row

    One activity within a week's editable list: structural fields form plus its narrative
    Custom Field editors. Only rendered inside coordinator_view for the author.

    Example context (json):
    {
        "id": 5,
        "weekid": 2,
        "title": "Forum kickoff",
        "type": "forum",
        "category": "asynchronous",
        "points": 10,
        "fields": [
            {
                "fieldid": 3,
                "instanceid": 5,
                "elementid": "syllabus-field-5-3",
                "name": "Student instructions",
                "text": "",
                "itemid": 12
            }
        ]
    }
}}
<div class="syllabus-activity-row border rounded p-2 mb-2" data-activityid="{{id}}" data-weekid="{{weekid}}">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="visually-hidden" for="syllabus-activity-title-{{id}}">
                {{#str}} activitytitle, mod_syllabus {{/str}}
            </label>
            <input type="text" class="form-control syllabus-activity-title" id="syllabus-activity-title-{{id}}"
                value="{{title}}" placeholder="{{#str}} activitytitle, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2">
            <label class="visually-hidden" for="syllabus-activity-type-{{id}}">
                {{#str}} activitytype, mod_syllabus {{/str}}
            </label>
            <input type="text" class="form-control syllabus-activity-type" id="syllabus-activity-type-{{id}}"
                value="{{type}}" placeholder="{{#str}} activitytype, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2">
            <label class="visually-hidden" for="syllabus-activity-category-{{id}}">
                {{#str}} activitycategory, mod_syllabus {{/str}}
            </label>
            <input type="text" class="form-control syllabus-activity-category" id="syllabus-activity-category-{{id}}"
                value="{{category}}" placeholder="{{#str}} activitycategory, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2">
            <label class="visually-hidden" for="syllabus-activity-points-{{id}}">
                {{#str}} activitypoints, mod_syllabus {{/str}}
            </label>
            <input type="number" step="0.01" class="form-control syllabus-activity-points"
                id="syllabus-activity-points-{{id}}" value="{{points}}"
                placeholder="{{#str}} activitypoints, mod_syllabus {{/str}}">
        </div>
        <div class="col-md-2 text-end">
            <button type="button" class="btn btn-sm btn-primary syllabus-save-activity">
                {{#str}} save, core {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger syllabus-delete-activity"
                data-confirm="{{#str}} confirmdeleteactivity, mod_syllabus {{/str}}">
                {{#str}} delete, core {{/str}}
            </button>
        </div>
    </div>
    {{#fields}}
    <div class="syllabus-field mt-2">
        <label for="{{elementid}}">{{name}}</label>
        <textarea id="{{elementid}}" class="syllabus-customfield-editor" data-fieldid="{{fieldid}}"
            data-instanceid="{{instanceid}}" data-area="activity" data-itemid="{{itemid}}">{{text}}</textarea>
        <span class="syllabus-save-status d-none small text-muted"
            data-saving="{{#str}} saving, mod_syllabus {{/str}}"
            data-saved="{{#str}} saved, mod_syllabus {{/str}}"></span>
    </div>
    {{/fields}}
</div>
