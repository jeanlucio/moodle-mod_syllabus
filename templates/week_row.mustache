{{!
    @template mod_syllabus/week_row

    One week within the editable weeks list: structural fields form, narrative Custom Field
    editors, and its own list of activities. Only rendered inside tab_full_plan for the
    author. Structural fields autosave on change (amd/src/weeks_manager.js) — there is no
    per-row "Save" button; only "Delete" remains. New rows are created by the
    "Add week"/"Add activity" buttons calling the web service directly with a default title,
    then reloading — this row is always a real, already-saved record.

    structuralhelp (weekplanning/syncmeeting keys) is set once on tab_full_plan's own context
    and read here via Mustache's normal context-stack fallback (same pattern as tinyavailable
    in narrative_field.mustache) — each value is pre-rendered HTML from the 'help' Custom
    Field area (plan_reader::structural_help()), institution-editable via managefields.php.
    hasmultiplestages is set the same way — the Stage select is a per-WEEK choice (every
    activity in the week inherits it, no per-activity select anywhere), and only rendered at
    all when the plan has more than one grading stage.

    The row is a native <details> element, open by default, with its own collapsible summary
    bar (title + a live "Xh · date range · N activities · Y pts" line kept up to date by
    amd/src/plan_navigator.js on every input/change, the same delegated listener that already
    recomputes the totals bar). The "Collapse all" control in the totals bar toggles every
    row's [open] attribute at once.

    Example context (json):
    {
        "id": 2,
        "title": "Week 1",
        "duration": 90,
        "startdatefield": {
            "fieldid": "syllabus-week-startdate-2",
            "fieldclass": "syllabus-week-startdate",
            "labeltext": "Start date",
            "timestamp": 1749000000
        },
        "enddatefield": {
            "fieldid": "syllabus-week-enddate-2",
            "fieldclass": "syllabus-week-enddate",
            "labeltext": "End date",
            "timestamp": 1749600000
        },
        "syncdate": 1749250000,
        "synclink": "https://meet.example.org/week1",
        "synctopic": "Kickoff session",
        "hasmultiplestages": false,
        "stage": 1,
        "stageoptions": [
            {"value": 1, "label": "Stage 1", "selected": true}
        ],
        "structuralhelp": {
            "weekplanning": "<p>Set this class's duration and period...</p>",
            "syncmeeting": "<p>Date, time, link and topic of this week's live meeting...</p>"
        },
        "fields": [
            {
                "fieldid": 7,
                "instanceid": 2,
                "elementid": "syllabus-field-2-7",
                "name": "Details",
                "text": "",
                "itemid": 9,
                "area": "week",
                "isplanfield": false,
                "description": "<p>Describe what happens in this week's class.</p>"
            }
        ],
        "activities": [],
        "hasactivities": false
    }
}}
<details class="syllabus-week-row border rounded mb-3" data-weekid="{{id}}"
    id="syllabus-section-week-{{id}}" data-syllabus-section open>
    <summary class="syllabus-week-summary">
        <span class="syllabus-week-toggle-icon" aria-hidden="true"></span>
        <span class="syllabus-week-summary-title">{{title}}</span>
        <span class="syllabus-week-summary-meta"></span>
    </summary>
    <div class="syllabus-week-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1" for="syllabus-week-title-{{id}}">
                    {{#str}} weektitle, mod_syllabus {{/str}}
                </label>
                <input type="text" class="form-control syllabus-week-title syllabus-required-input" id="syllabus-week-title-{{id}}"
                    value="{{title}}" placeholder="{{#str}} weektitle, mod_syllabus {{/str}}">
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="syllabus-week-duration-{{id}}">
                    {{#str}} weekduration, mod_syllabus {{/str}}
                </label>
                <input type="number" class="form-control syllabus-week-duration" id="syllabus-week-duration-{{id}}"
                    value="{{duration}}" placeholder="{{#str}} weekduration, mod_syllabus {{/str}}">
            </div>
            {{#hasmultiplestages}}
            <div class="col-md-2">
                <label class="form-label small mb-1" for="syllabus-week-stage-{{id}}">
                    {{#str}} stage, mod_syllabus {{/str}}
                </label>
                <select class="form-select syllabus-week-stage" id="syllabus-week-stage-{{id}}">
                    {{#stageoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/stageoptions}}
                </select>
            </div>
            {{/hasmultiplestages}}
            <div class="col-md-3 text-end">
                <span class="syllabus-save-status syllabus-week-save-status d-none small text-muted me-2"
                    data-saving="{{#str}} saving, mod_syllabus {{/str}}"
                    data-saved="{{#str}} saved, mod_syllabus {{/str}}"></span>
                <button type="button" class="btn btn-sm btn-outline-danger syllabus-delete-week"
                    data-confirm="{{#str}} confirmdeleteweek, mod_syllabus {{/str}}">
                    {{#str}} delete, core {{/str}}
                </button>
            </div>
        </div>
        <div class="row g-2 align-items-end mt-1">
            <div class="col-md-6">
                {{#startdatefield}}{{> mod_syllabus/date_select }}{{/startdatefield}}
            </div>
            <div class="col-md-6">
                {{#enddatefield}}{{> mod_syllabus/date_select }}{{/enddatefield}}
            </div>
        </div>
        <div class="mt-1">{{{structuralhelp.weekplanning}}}</div>
        <div class="row g-2 align-items-end mt-2">
            <div class="col-md-4">
                <label class="form-label small mb-1" for="syllabus-week-syncdate-{{id}}">
                    {{#str}} syncmeetingdate, mod_syllabus {{/str}}
                </label>
                <input type="datetime-local" class="form-control form-control-sm syllabus-week-syncdate"
                    id="syllabus-week-syncdate-{{id}}" data-timestamp="{{syncdate}}">
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1" for="syllabus-week-synclink-{{id}}">
                    {{#str}} syncmeetinglink, mod_syllabus {{/str}}
                </label>
                <input type="url" class="form-control form-control-sm syllabus-week-synclink"
                    id="syllabus-week-synclink-{{id}}" value="{{synclink}}"
                    placeholder="{{#str}} syncmeetinglink, mod_syllabus {{/str}}">
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1" for="syllabus-week-synctopic-{{id}}">
                    {{#str}} syncmeetingtopic, mod_syllabus {{/str}}
                </label>
                <input type="text" class="form-control form-control-sm syllabus-week-synctopic"
                    id="syllabus-week-synctopic-{{id}}" value="{{synctopic}}"
                    placeholder="{{#str}} syncmeetingtopic, mod_syllabus {{/str}}">
            </div>
        </div>
        <div class="mt-1 mb-2">{{{structuralhelp.syncmeeting}}}</div>
        {{#fields}}
            {{> mod_syllabus/narrative_field }}
        {{/fields}}

        <h5 class="mt-3">{{#str}} activities, mod_syllabus {{/str}}</h5>
        <div class="syllabus-activities-list">
            {{#activities}}
                {{> mod_syllabus/activity_row }}
            {{/activities}}
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary syllabus-add-activity" data-weekid="{{id}}">
            {{#str}} addactivity, mod_syllabus {{/str}}
        </button>
    </div>
</details>
