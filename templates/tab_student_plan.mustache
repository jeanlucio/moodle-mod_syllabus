{{!
    @template mod_syllabus/tab_student_plan

    Tab 2 — "Student's plan". Read-only projection of the plan: Characterisation, full
    narrative plan content, every week (with synchronous meetings and bibliography) and
    activity (with instructions), and the consolidated schedule. Never receives grading
    criteria, tutor guidance, interaction tools or observations — see
    plan_read_export::weeks().

    Example context (json):
    {
        "statuslabel": "Approved",
        "statusbadgeclass": "bg-success",
        "coursename": "Distance Education Fundamentals",
        "disciplinename": "Introduction to Educational Technology",
        "teachername": "Jane Doe",
        "academicperiod": "2026.1",
        "coursestartdate": 1749020400,
        "courseenddate": 1751342400,
        "totalduration": 1800,
        "presentationvideourl": "https://example.com/presentation-video",
        "coursedescription": "<p>An overview of how digital tools support distance learning...</p>",
        "objectives": "<p>Enable students to design and evaluate digital learning materials...</p>",
        "contents": "<p>Week 1 - Introduction to the subject...</p>",
        "methodology": "<p>Hello, dear student!...</p>",
        "presentationscript": "<p>Hello everyone! Welcome to the course...</p>",
        "generalreferences": "<p>DOE, J. et al...</p>",
        "hasweeks": false,
        "weeks": [],
        "hasfinalassessment": false,
        "finalassessment": {},
        "hasschedule": false,
        "schedule": []
    }
}}
<div class="path-mod-syllabus syllabus-tab-student">
    <div class="syllabus-status mb-3">
        <span class="badge {{statusbadgeclass}} syllabus-status-badge">{{statuslabel}}</span>
    </div>

    <h3>{{#str}} characterisation, mod_syllabus {{/str}}</h3>
    <div class="syllabus-characterisation-grid mb-3">
        <div>
            <span class="syllabus-grid-label">{{#str}} studyprogram, mod_syllabus {{/str}}</span>
            {{coursename}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} discipline, mod_syllabus {{/str}}</span>
            {{disciplinename}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} teacher, mod_syllabus {{/str}}</span>
            {{teachername}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} academicperiod, mod_syllabus {{/str}}</span>
            {{academicperiod}}
        </div>
        {{#coursestartdate}}
        <div>
            <span class="syllabus-grid-label">{{#str}} courseperiod, mod_syllabus {{/str}}</span>
            {{#userdate}} {{coursestartdate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}
            {{#courseenddate}}– {{#userdate}} {{courseenddate}}, {{#str}} strftimedatefullshort, core_langconfig {{/str}} {{/userdate}}{{/courseenddate}}
        </div>
        {{/coursestartdate}}
        {{#totalduration}}
        <div>
            <span class="syllabus-grid-label">{{#str}} totalworkload, mod_syllabus {{/str}}</span>
            {{totalduration}}
        </div>
        {{/totalduration}}
    </div>

    {{#presentationscript}}
    <h3>{{#str}} presentationscript, mod_syllabus {{/str}}</h3>
    {{#presentationvideourl}}
    <p><a href="{{presentationvideourl}}" target="_blank" rel="noopener">{{#str}} presentationvideo, mod_syllabus {{/str}}</a></p>
    {{/presentationvideourl}}
    <div class="syllabus-presentationscript mb-3">{{{presentationscript}}}</div>
    {{/presentationscript}}

    <h3>{{#str}} coursedescription, mod_syllabus {{/str}}</h3>
    <div class="syllabus-coursedescription mb-3">{{{coursedescription}}}</div>

    <h3>{{#str}} objectives, mod_syllabus {{/str}}</h3>
    <div class="syllabus-objectives mb-3">{{{objectives}}}</div>

    <h3>{{#str}} contents, mod_syllabus {{/str}}</h3>
    <div class="syllabus-contents mb-3">{{{contents}}}</div>

    <h3>{{#str}} methodology, mod_syllabus {{/str}}</h3>
    <div class="syllabus-methodology mb-3">{{{methodology}}}</div>

    <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
    {{#hasweeks}}
        {{#weeks}}
            {{> mod_syllabus/plan_week_read }}
        {{/weeks}}
    {{/hasweeks}}
    {{^hasweeks}}
    <p class="text-muted">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
    {{/hasweeks}}

    {{> mod_syllabus/plan_final_assessment }}

    {{#generalreferences}}
    <h3>{{#str}} generalreferences, mod_syllabus {{/str}}</h3>
    <div class="syllabus-generalreferences mb-3">{{{generalreferences}}}</div>
    {{/generalreferences}}

    {{> mod_syllabus/plan_schedule }}
</div>
