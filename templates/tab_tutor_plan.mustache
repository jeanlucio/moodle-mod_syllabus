{{!
    @template mod_syllabus/tab_tutor_plan

    Tab 3 — "Tutor plan". Read-only: a reduced Characterisation (no full plan-level narrative,
    including Final assessment — the tutor has Tab 2 for that, one click away), every week and
    activity with the tutor-exclusive fields included (interaction tools, observations,
    grading criteria with answer keys, tutor guidance), and the consolidated schedule. Never
    reachable by the student (view.php gates it on mod/syllabus:viewtutorview).

    Example context (json):
    {
        "statuslabel": "Approved",
        "statusbadgeclass": "bg-success",
        "coursename": "Distance Education Fundamentals",
        "disciplinename": "Introduction to Educational Technology",
        "teachername": "Jane Doe",
        "academicperiod": "2026.1",
        "totalduration": 1800,
        "hasweeks": false,
        "weeks": [],
        "hasschedule": false,
        "schedule": []
    }
}}
<div class="path-mod-syllabus syllabus-tab-tutor">
    <div class="syllabus-status mb-3">
        <span class="badge {{statusbadgeclass}} syllabus-status-badge">{{statuslabel}}</span>
    </div>

    <h3>{{#str}} characterisation, mod_syllabus {{/str}}</h3>
    <div class="syllabus-characterisation-grid mb-3">
        <div>
            <span class="syllabus-grid-label">{{#str}} studyprogram, mod_syllabus {{/str}}</span>
            {{coursename}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} discipline, mod_syllabus {{/str}}</span>
            {{disciplinename}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} teacher, mod_syllabus {{/str}}</span>
            {{teachername}}
        </div>
        <div>
            <span class="syllabus-grid-label">{{#str}} academicperiod, mod_syllabus {{/str}}</span>
            {{academicperiod}}
        </div>
        {{#totalduration}}
        <div>
            <span class="syllabus-grid-label">{{#str}} totalworkload, mod_syllabus {{/str}}</span>
            {{totalduration}}
        </div>
        {{/totalduration}}
    </div>

    {{#hasweeks}}
        {{#weeks}}
            {{> mod_syllabus/plan_week_read }}
        {{/weeks}}
    {{/hasweeks}}
    {{^hasweeks}}
    <p class="text-muted">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
    {{/hasweeks}}

    {{> mod_syllabus/plan_schedule }}
</div>
