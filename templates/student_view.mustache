{{!
    @template mod_syllabus/student_view

    Plano de Disciplina do Aluno view. Never receives grading criteria/gabarito or tutor
    accompaniment notes — those fields are simply never exported into this template's data.

    Example context (json):
    {
        "coursedescription": "<p>Course description text.</p>",
        "objectives": "<p>Course objectives text.</p>",
        "contents": "<p>Course contents text.</p>",
        "methodology": "<p>Course methodology text.</p>"
    }
}}
<div class="path-mod-syllabus">
    <h3>{{#str}} coursedescription, mod_syllabus {{/str}}</h3>
    <div class="syllabus-coursedescription">{{{coursedescription}}}</div>

    <h3>{{#str}} objectives, mod_syllabus {{/str}}</h3>
    <div class="syllabus-objectives">{{{objectives}}}</div>

    <h3>{{#str}} contents, mod_syllabus {{/str}}</h3>
    <div class="syllabus-contents">{{{contents}}}</div>

    <h3>{{#str}} methodology, mod_syllabus {{/str}}</h3>
    <div class="syllabus-methodology">{{{methodology}}}</div>

    <h3>{{#str}} weeks, mod_syllabus {{/str}}</h3>
    <p class="text-muted">{{#str}} noweeksyet, mod_syllabus {{/str}}</p>
</div>
